# Salin menjadi .env lalu sesuaikan. Nilai di bawah adalah bawaannya.

# Lokasi data. Harus di filesystem Linux, jangan di /mnt/c.
BIGDATA_DATA_ROOT=/home/brainard/bigdata-data


# Setelan Spark. Turunkan driver memory kalau WSL kehabisan RAM.
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=16
